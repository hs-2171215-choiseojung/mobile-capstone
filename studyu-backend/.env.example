# ── Supabase ──
# Supabase 대시보드 → Settings → API 에서 복사
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=여기에_anon_key_붙여넣기
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_붙여넣기

# ── OpenAI ──
# https://platform.openai.com/api-keys 에서 생성
OPENAI_API_KEY=sk-여기에_openai_key_붙여넣기

# ── 서버 설정 ──
FRONTEND_URL=http://localhost:3000

# ── Google Cloud STT ──
# Google Cloud Console → 서비스 계정 → 키 생성(JSON) 후 파일명 입력
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json
GCP_PROJECT_ID=여기에_gcp_project_id_붙여넣기
