{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "studyu-backend", "region": "asia-east1" }
      },
      {
        "source": "**",
        "run": { "serviceId": "studyu-frontend", "region": "asia-east1" }
      }
    ]
  }
}
